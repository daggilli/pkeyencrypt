#!/usr/bin/env bash
# compare file1 to file2 byte for byte
# needs gawk
if [ "$#" -lt 2 ]; then
  echo usage: $(basename $0) file1 file2
  exit
fi
if [ "$1" == "$2" ]; then
  echo file1 and file2 must differ
  exit
fi

cmp -l "$1" "$2" | gawk '{printf "%08X %02X %02X\n", $1-1, strtonum(0$2), strtonum(0$3)}'